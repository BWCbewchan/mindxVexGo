+import * as Blockly from 'blockly'
+import { VEX_DRIVE_BLOCKS, VEX_TURN_BLOCKS } from './workspaceRobot'
+
+/**
+ * VEXcode-style command set (VEXcode GO / IQ wording, as used by mindX VR Lab).
+ * Numbers are value inputs so variables and reporters can be dropped in, like VEXcode.
+ * Compiled by BlocklyCompiler to the same Instruction IR as the original RoboCode blocks.
+ */
+export const VEX_DRIVETRAIN_BLOCKS = [...VEX_DRIVE_BLOCKS, ...VEX_TURN_BLOCKS] as const
+export const VEX_CONTROL_BLOCKS = ['vex_wait', 'vex_wait_until', 'vex_repeat', 'vex_forever', 'vex_repeat_until', 'vex_while', 'vex_stop_project'] as const
