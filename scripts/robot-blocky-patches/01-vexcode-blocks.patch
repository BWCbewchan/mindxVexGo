+import type { RobotDefinition } from '../simulation/RobotDefinition'
+
+// Blockly-free record of the robot each workspace programs, so the compiler can resolve
+// default devices for VEXcode blocks without importing Blockly at runtime.
+const robots = new WeakMap<object, RobotDefinition>()
+export function rememberWorkspaceRobot(workspace: object, definition: RobotDefinition) { robots.set(workspace, definition) }
+export function workspaceRobot(workspace: object): RobotDefinition | undefined { return robots.get(workspace) }
+
+export type VexKit = 'go' | 'iq'
+const KIT_KEY = 'robocode.vexKit'
+let kit: VexKit = (() => { try { return globalThis.localStorage?.getItem(KIT_KEY) === 'iq' ? 'iq' : 'go' } catch { return 'go' } })()
+/** Which VEXcode command set the toolbox shows: VEX GO or VEX IQ wording. Saved per browser. */
+export function vexKit(): VexKit { return kit }
+export function setVexKit(next: VexKit) { kit = next; try { globalThis.localStorage?.setItem(KIT_KEY, next) } catch { /* storage blocked: keep for this session */ } }
+
+/** VEXcode block types grouped by the drivetrain capability they need. */
+export const VEX_DRIVE_BLOCKS = ['vex_drive', 'vex_drive_for', 'vex_stop_driving', 'vex_set_drive_velocity'] as const
+export const VEX_TURN_BLOCKS = ['vex_turn', 'vex_turn_for', 'vex_turn_to_heading', 'vex_set_turn_velocity', 'vex_set_drive_heading'] as const
