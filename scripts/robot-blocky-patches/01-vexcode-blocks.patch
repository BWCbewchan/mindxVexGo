+    { type: 'vex_iq_gyro_calibrate', message0: 'calibrate Gyro', ...stack, tooltip: 'Đặt hướng Gyro về 0° tại vị trí hiện tại.' },
+    { type: 'vex_iq_gyro_heading', message0: 'Gyro heading in degrees', output: 'Number', tooltip: '0–359,9°, tăng theo chiều kim đồng hồ.' },
