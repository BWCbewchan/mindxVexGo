diff --git a/src/simulation/TrainingMaps.ts b/src/simulation/TrainingMaps.ts
new file mode 100644
index 0000000..1ad7338
--- /dev/null
+++ b/src/simulation/TrainingMaps.ts
@@ -0,0 +1,70 @@
+import type { WorldObject, SensorColor } from './Sensors'
+import { CHECKPOINT_RULES, type MapRules } from './MapBuild'
+import type { MapParticipationPolicy } from '../../shared/map-policy.mjs'
+import { TRAINING_MISSIONS, type TrainingField, type TrainingMission } from './trainingFields'
+
+// mindX: the 2D /training fields (millimetres, y down, heading clockwise from "up") as 3D challenge maps.
+// The RoboCode robot is about 1 m wide, so a field is scaled up: 1200 mm becomes 16 m, the size of
+// the built-in challenges. START moves to (0, 0) facing +Z; the robot's right side is -X.
+export const TRAINING_SCALE = 16 / 1200
+const WALL_HEIGHT = .6, BORDER = .3
+
+export const trainingMapId = (id: string) => `training-${id}`
+export const TRAINING_MAP_IDS: readonly string[] = TRAINING_MISSIONS.map(mission => trainingMapId(mission.id))
+/** Fields with cargo get the magnet robot (VEX GO Electromagnet). */
+export const TRAINING_MAGNET_IDS: ReadonlySet<string> = new Set(TRAINING_MISSIONS.filter(mission => mission.field.blocks?.length).map(mission => trainingMapId(mission.id)))
+export const TRAINING_DIFFICULTY: Readonly<Record<string, 'easy' | 'medium' | 'hard'>> = Object.fromEntries(TRAINING_MISSIONS.map(mission => [trainingMapId(mission.id), /CHALLENGE/.test(mission.level) ? 'hard' : /INTERMEDIATE/.test(mission.level) ? 'medium' : 'easy']))
+
+const POLICY: MapParticipationPolicy = { allowedVehicleIds: 'any', allowedDrivetrainIds: ['differential'], requiredCapabilities: ['drive', 'turn'], deviceRules: [], recommendedBuildIds: ['default-two-motor'] }
+
+function color(value: string): SensorColor {
+  if (value === 'red' || value === 'green' || value === 'blue') return value
+  const match = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(value)
+  if (!match) return 'white'
+  const [r, g, b] = match.slice(1).map(part => parseInt(part, 16))
+  const palette: [SensorColor, number, number, number][] = [['red', 223, 83, 97], ['green', 49, 150, 91], ['blue', 57, 127, 214], ['yellow', 240, 200, 60], ['black', 20, 24, 32], ['white', 250, 250, 250]]
+  return palette.reduce((best, item) => (item[1] - r) ** 2 + (item[2] - g) ** 2 + (item[3] - b) ** 2 < (best[1] - r) ** 2 + (best[2] - g) ** 2 + (best[3] - b) ** 2 ? item : best)[0]
+}
+
+/** Field millimetres → RoboCode metres, relative to START and its heading. */
+export function trainingFrame(field: TrainingField) {
+  const angle = field.start.heading * Math.PI / 180
+  const forward = [Math.sin(angle), -Math.cos(angle)], right = [Math.cos(angle), Math.sin(angle)]
+  const swap = Math.round(field.start.heading / 90) % 2 !== 0
+  const point = (x: number, y: number) => {
+    const dx = x - field.start.x, dy = y - field.start.y
+    return { x: -(dx * right[0] + dy * right[1]) * TRAINING_SCALE, z: (dx * forward[0] + dy * forward[1]) * TRAINING_SCALE }
+  }
+  const rect = (x: number, y: number, width: number, height: number) => ({ ...point(x + width / 2, y + height / 2), width: (swap ? height : width) * TRAINING_SCALE, depth: (swap ? width : height) * TRAINING_SCALE })
+  return { point, rect }
+}
+
+export function trainingMapDefinition(mission: TrainingMission) {
+  const { field } = mission
+  const { point, rect } = trainingFrame(field)
+  const id = trainingMapId(mission.id)
+  const border = BORDER / TRAINING_SCALE
+  const objects: WorldObject[] = [
+    { id: 'training-border-top', ...rect(-border, -border, field.width + 2 * border, border), height: WALL_HEIGHT },
+    { id: 'training-border-bottom', ...rect(-border, field.height, field.width + 2 * border, border), height: WALL_HEIGHT },
+    { id: 'training-border-left', ...rect(-border, 0, border, field.height), height: WALL_HEIGHT },
+    { id: 'training-border-right', ...rect(field.width, 0, border, field.height), height: WALL_HEIGHT },
+    ...field.walls.map((wall, index): WorldObject => ({ id: `training-wall-${index + 1}`, ...rect(wall.x, wall.y, wall.width, wall.height), height: WALL_HEIGHT, color: 'black' })),
+    ...(field.zones ?? []).map((zone, index): WorldObject => { const size = zone.radius * 2 * TRAINING_SCALE; return { id: `training-zone-${index + 1}`, ...point(zone.x, zone.y), y: .003, width: size, depth: size, height: .004, shape: 'disc', surface: true, color: color(zone.color) } }),
+    ...(field.blocks ?? []).map((cargo): WorldObject => ({ id: `training-${cargo.id}`, ...point(cargo.x, cargo.y), width: .42, depth: .42, height: .06, shape: 'disc', pushable: true, material: 'metal', mass: .3, color: color(cargo.color) })),
+  ]
+  const corners = objects.flatMap(object => [Math.abs(object.x) + object.width / 2, Math.abs(object.z) + object.depth / 2])
+  const number = mission.level.split('·')[0].trim()
+  const rules: MapRules = CHECKPOINT_RULES
+  return {
+    id, version: 1, rules,
+    name: `Training ${number} · ${field.name}`,
+    description: `${mission.description} Sa bàn 2D của Training mindX dựng thành sân 3D, phóng to ×${(TRAINING_SCALE * 1000).toFixed(1).replace('.', ',')} để vừa robot RoboCode (${field.width} × ${field.height} mm → ${(field.width * TRAINING_SCALE).toFixed(1).replace('.', ',')} × ${(field.height * TRAINING_SCALE).toFixed(1).replace('.', ',')} m).${field.requireBumper ? ' Bản 2D yêu cầu chạm Bumper trước khi về đích.' : ''}`,
+    arenaSize: Math.ceil(2 * Math.max(...corners) + 1),
+    checkpoints: (field.checkpoints ?? []).map((checkpoint, index) => ({ ...point(checkpoint.x, checkpoint.y), label: `CP${index + 1}` })),
+    goal: { ...point(field.goal.x, field.goal.y), label: 'ĐÍCH' },
+    objects, policy: POLICY,
+  }
+}
+
+export const trainingMapDefinitions = () => TRAINING_MISSIONS.map(trainingMapDefinition)
