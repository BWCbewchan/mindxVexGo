diff --git a/tests/training-maps.test.mjs b/tests/training-maps.test.mjs
new file mode 100644
index 0000000..f1d04c4
--- /dev/null
+++ b/tests/training-maps.test.mjs
@@ -0,0 +1,35 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { fileURLToPath } from 'node:url'
+import { createSourceLoader } from '../scripts/load-ts-source.mjs'
+const load = createSourceLoader(fileURLToPath(new URL('..', import.meta.url)))
+const { TRAINING_MAP_IDS, TRAINING_SCALE, trainingFrame } = load('src/simulation/TrainingMaps.ts')
+const { TRAINING_MISSIONS } = load('src/simulation/trainingFields.ts')
+const { CHALLENGE_MAPS } = load('src/simulation/ChallengeMaps.ts')
+const { PLAYGROUND_MAPS } = load('src/application/PlaygroundCatalog.ts')
+const { createBuiltinMapDocument, validateMapForRuntime } = load('src/application/MapDocumentCatalog.ts')
+
+test('every mindX Training field becomes a playable 3D challenge', () => {
+  assert.equal(TRAINING_MAP_IDS.length, TRAINING_MISSIONS.length)
+  for (const id of TRAINING_MAP_IDS) {
+    assert.ok(CHALLENGE_MAPS.some(map => map.id === id), id)
+    const entry = PLAYGROUND_MAPS.find(map => map.id === id)
+    assert.ok(entry?.training && entry.graded, id)
+    assert.equal(validateMapForRuntime(createBuiltinMapDocument(id)).map(issue => issue.message).join('; '), '', id)
+  }
+})
+
+test('START sits at the origin facing +Z and the field keeps its layout', () => {
+  const mission = TRAINING_MISSIONS.find(item => item.id === 'first-journey')
+  const map = CHALLENGE_MAPS.find(item => item.id === 'training-first-journey')
+  const { point } = trainingFrame(mission.field)
+  const start = point(mission.field.start.x, mission.field.start.y)
+  assert.ok(Math.abs(start.x) < 1e-9 && Math.abs(start.z) < 1e-9)
+  // Heading 90 faces +x on the 2D field; the goal 700 mm ahead is straight in front of the robot.
+  assert.ok(Math.abs(map.goal.x) < 1e-9)
+  assert.ok(Math.abs(map.goal.z - 700 * TRAINING_SCALE) < 1e-9)
+  // Heading 0 faces up (−y); a point to the right on screen is on the robot's right (−X).
+  const up = trainingFrame({ ...mission.field, start: { x: 500, y: 500, heading: 0 } }).point
+  assert.ok(up(500, 400).z > 0 && Math.abs(up(500, 400).x) < 1e-9)
+  assert.ok(up(600, 500).x < 0)
+})
