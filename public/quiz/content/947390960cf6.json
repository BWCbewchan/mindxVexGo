mage", "src": "/quiz/images/947390960cf6-read-90665476eccc.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện"}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhiệm vụ 1: Khi bạn báo phát hiện vật thể màu đỏ, bạn báo chạy lùi lại và sau 3s thì dừng hẳn."}, {"type": "image", "src": "/quiz/images/947390960cf6-read-85fc3eb8b857.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhiệm vụ 2: Báo đốm đi săn, khi phát hiện con mồi sẽ đi thật chậm sau 3s sẽ tăng tốc về phía trước bắt con mồi."}, {"type": "image", "src": "/quiz/images/947390960cf6-read-d5abd8cdf247.png", "text": "Hình gốc trong tài liệu"}]}]]}, {"type": "text", "text": "BÀI 12"}, {"type": "text", "text": "CÔNG XƯỞNG SÁNG TẠO"}, {"type": "text", "text": "1. Ý NGHĨA THẺ LỆNH"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-9f3f75fa9c97.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Não dùng để điều khiển các linh kiện điện tử"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-d377c7205d1d.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Pin dùng để cung cấp năng lượng cho não"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-269da2070994.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ giúp mô hình hoạt động."}, {"type": "text", "text": "Động cơ quay theo 2 chiều là cùng chiều kim đồng hồ và ngược chiều kim đồng hồ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-5207cc3f4410.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "LED Bumper còn dùng để hiển thị - phát màu là màu xanh lá và màu đỏ"}, {"type": "text", "text": "Led Bumper được sử dụng như một nút ấn khẩn cấp"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-3d50cc93d2a8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cảm biến mắt dùng để phát hiện vệt cản, phân biệt màu sắc"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-4493e9c484a8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nam châm điện dùng để hút và thả vật kim loại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-a17d5afbcca3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Công tắc"}]}]]}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-7a1a6952f054.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-606b77397f22.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  quay không liên tục."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-15bc82ca037c.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-85c4cbaf46c8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  quay liên tục"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-4353a80afa3a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thiết lập tốc độ của động cơ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-aa1a8337886e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  dừng lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-4b42468ff193.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ … giây"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-c451a6ca2510.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Đợi đến khi, LED Bumper được ấn"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-29e645c7d375.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-dc26c56e4f68.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh hút/nhả nam châm điện."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-ba36df6bbfbd.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-39f6e8d3acf6.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-178ee2145a77.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Đợi đến khi, Cảm biến mắt phát hiện màu Đỏ/Xanh lá/Xanh dương."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-fcebafc44675.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-aea336e94c3e.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-e2f05d20a73a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Hiển thị màu sắc trên Led Bumper Xanh lá/ Đỏ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/947390960cf6-read-c7d78c8acdb3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh vòng lặp, thực hiện lặp lại các thẻ lệnh bên trong… lần."}]}]]}, {"type": "text", "text": "2. LUYỆN TẬP THUYẾT TRÌNH"}, {"type": "text", "text": "a. Chuẩn bị tác phong"}, {"type": "text", "text": "Chuẩn bị đầy đủ kiến thức, lời cần nói"}, {"type": "text", "text": "Xác định người xem"}, {"type": "text", "text": "Ăn mặc lịch sự, giọng nói dễ nghe."}, {"type": "text", "text": "b. Cách thuyết trình ấn tượng"}, {"type": "text", "text": "Phần mở đầu (Luôn thêm kính ngữ dạ thưa)"}, {"type": "text", "text": "(1) Giới thiệu họ tên, tên mô hình."}, {"type": "text", "text": "(2) Dẫn dắt mọi người cùng thưởng thức phần trình bày của mình."}, {"type": "text", "text": "Ví dụ:"}, {"type": "text", "text": "(1) Xin chào quý thầy cô, quý phụ huynh và các bạn đã có mặt trong buổi Demo cuối khoá. Em tên là Nguyễn Văn Nam, học lớp Robotics tại MindX. Sau đây em xin trình bày mô hình Demo của em."}, {"type": "text", "text": "Mô hình của em có tên là …"}, {"type": "text", "text": "(2) Xin mời quý thầy cô, quý phụ huynh và các bạn xem phần hoạt động của mô hình."}, {"type": "text", "text": "Phần thân bài"}, {"type": "text", "text": "Học viên thực hiện phần hoạt động của mô hình"}, {"type": "text", "text": "GV đặt câu hỏi để HV trả lời"}, {"type": "text", "text": "Lưu ý: Tác phong lịch sự khi đứng thuyết trình, sử dụng ngôn ngữ cơ thể."}, {"type": "text", "text": "Phần tổng kết"}, {"type": "text", "text": "Gửi lời cảm ơn với người xem."}, {"type": "text", "text": "Ví dụ: Phần “gửi lời cảm ơn người xem”"}, {"type": "text", "text": "Cảm ơn tất cả mọi người đã cùng đồng hành và theo dõi phần trình bày của em. Em hy vọng mọi người đã có một trải nghiệm trọn vẹn và ấn tượng tốt về phần sản phẩm thiết kế của em. Em xin cảm ơn!"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-fe8ffe421b40.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/947390960cf6-read-ef646e2e91f4.png", "text": "Hình gốc trong tài liệu"}]}