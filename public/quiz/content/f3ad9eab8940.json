997d9b70d.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Bánh răng chủ động quay sẽ giúp bánh răng thụ động quay theo nhưng chiều ngược lại."}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "text", "text": "Chạy thẳng 5 giây sau đó tăng tốc 2 giây rồi dừng lại."}, {"type": "image", "src": "/quiz/images/f3ad9eab8940-read-f1faffbc6182.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Đánh dấu ✔ vào ô em cho là đúng nhất"}, {"type": "text", "text": "Cặp bánh răng nào sẽ giúp xe chạy nhanh nhất"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/f3ad9eab8940-read-347b42bed12f.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/f3ad9eab8940-read-d258752e3fef.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/f3ad9eab8940-read-7e3bdaac240d.png", "text": "Hình gốc trong tài liệu"}]}]]}]}