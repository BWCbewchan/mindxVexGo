{"blocks": [{"type": "text", "text": "BÀI 6"}, {"type": "text", "text": "SÓI CON LẠC MẸ"}, {"type": "image", "src": "/quiz/images/172075c0b253-read-64d3c0305938.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "1. Ý NGHĨA THẺ LỆNH"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-15bc82ca037c.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/172075c0b253-read-85c4cbaf46c8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ quay liên tục"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-4353a80afa3a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thiết lập tốc độ của động cơ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-aa1a8337886e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  dừng lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-4b42468ff193.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ … giây"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-a41804d2e85e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều khiển cảm biến mắt"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-c7d78c8acdb3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh vòng lặp, thực hiện lặp lại các thẻ lệnh bên trong… lần."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-8156782f0811.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện"}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "text", "text": "Nhiệm vụ 1: Khi bạn sói phát hiện vật thể có màu đỏ, thì sẽ rẽ hướng và tiếp tục chạy"}, {"type": "image", "src": "/quiz/images/172075c0b253-read-f367a11e8473.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 2: Sói con đi tiến lên chậm khi mắt phát hiện vật thể thì đi lùi lại, sau 3s thì tăng tốc đi về phía trước."}, {"type": "image", "src": "/quiz/images/172075c0b253-read-ad29006350bf.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Đoạn lệnh sau dùng để làm gì?"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/172075c0b253-read-4636c4337c71.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}]]}]}