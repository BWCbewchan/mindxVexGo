{"blocks": [{"type": "text", "text": "BÀI 4"}, {"type": "text", "text": "CÔNG XƯỞNG SÁNG TẠO"}, {"type": "text", "text": "1. Ôn tập mô hình"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-7cba1e5c7125.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-37319d04894c.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "2. Ôn tập thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/2071a0af2e33-read-1081e2fad2d6.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh di chuyển"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/2071a0af2e33-read-e98febab7fbb.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh quay motor nâng hàng"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/2071a0af2e33-read-36d6929f219e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh, nếu không thì không thực hiện gì cả"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/2071a0af2e33-read-69f43753f47a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh tương ứng, còn nếu điều kiện sai sẽ thực hiện câu lệnh tương ứng còn lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/2071a0af2e33-read-324a1a26b9ef.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh lặp lại mãi mãi, lặp lại các câu lệnh bên trong từ lúc bắt đầu tới lúc dừng chương trình"}]}]]}, {"type": "text", "text": "3. Nhiệm vụ lập trình"}, {"type": "text", "text": "Nhiệm vụ 1: Lập trình xe giao hàng di chuyển đến nơi quy định"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-c2913c0e7d0d.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-1d9684e79013.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 2: Lập trình xe giao hàng di chuyển đến nơi quy định"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-2bf5e24d80c2.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-9f02d7a78cdd.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 3: Lập trình xe giao hàng di chuyển đến nơi quy định"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-9c089c003a4b.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/2071a0af2e33-read-fbdbc19e10d2.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Trả lời các câu hỏi sau đây:\n1. Có thể gắn tối đa bao nhiêu LED Bumper vào mô hình?"}, {"type": "text", "text": "2. Sự khác nhau giữa nam châm điện và nam châm thường?"}]}