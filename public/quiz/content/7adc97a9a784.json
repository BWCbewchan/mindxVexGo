{"blocks": [{"type": "text", "text": "BÀI 8"}, {"type": "text", "text": "CÔNG XƯỞNG SÁNG TẠO"}, {"type": "text", "text": "1. Ôn tập, cải tiến mô hình"}, {"type": "image", "src": "/quiz/images/7adc97a9a784-read-0d30f1b49259.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/7adc97a9a784-read-24a06bf914df.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "2. Ôn tập thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-cbaa832daef6.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh di chuyển tiến, lùi liên tục"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-9ce051f8f63a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh di chuyển tiến lùi không liên tục"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-8906162d01b8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh quay trái, quay phải một góc 90 độ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-8bd3b24bdef8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm thẻ lệnh LED Bumper:"}, {"type": "text", "text": "Phát sáng màu đỏ"}, {"type": "text", "text": "Tăng độ sáng của đèn"}, {"type": "text", "text": "Khi bumper được nhấn"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-d76fa71df681.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh bật-tắt đèn của cảm biến mắt"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-3eb49358f960.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh cài đặt tầm nhìn của mắt"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-b4b5e8e24cf7.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều chỉnh độ sáng của đèn"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-b520fb2ae5e9.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh khi mắt nhìn thấy vật thể"}, {"type": "text", "text": "Thẻ lệnh khi mắt nhìn thấy màu đỏ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-51b1917248bb.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh đo độ sáng của vật thể"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-69f43753f47a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh tương ứng, còn nếu điều kiện sai sẽ thực hiện câu lệnh tương ứng còn lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7adc97a9a784-read-324a1a26b9ef.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh lặp lại mãi mãi, lặp lại các câu lệnh bên trong từ lúc bắt đầu tới lúc dừng chương trình"}]}]]}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Trả lời các câu hỏi sau đây:"}, {"type": "text", "text": "1. Tốc độ tối đa của động cơ là mức bao nhiêu? Có thể tùy chỉnh câu lệnh tốc độ lên bao nhiêu % là tối đa?"}, {"type": "text", "text": "2. Nếu thay đổi độ sáng của mắt về 0% thì đèn của mắt sẽ ở trạng thái nào?"}]}