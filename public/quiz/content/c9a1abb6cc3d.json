{"blocks": [{"type": "text", "text": "BÀI 2"}, {"type": "text", "text": "CÁNH CỔNG THẦN KỲ"}, {"type": "text", "text": "1. Ý NGHĨA THẺ LỆNH"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-7a1a6952f054.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-606b77397f22.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ quay không liên tục."}, {"type": "text", "text": "(Thẻ lệnh dùng đóng/mở cửa)"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-4b42468ff193.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ … giây"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-c451a6ca2510.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Đợi đến khi, LED Bumper được ấn"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-09bee258b9c4.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-eb995cbe7c0f.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-fc2da0ca23c3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Hiển thị màu sắc trên Led Bumper Xanh lá/ Đỏ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/c9a1abb6cc3d-read-c7d78c8acdb3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh vòng lặp, thực hiện lặp lại các thẻ lệnh bên trong… lần."}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "table", "text": "Bảng t