{"blocks": [{"type": "text", "text": "BÀI 7"}, {"type": "text", "text": "NÉ TRÁNH NGẠI VẬT"}, {"type": "text", "text": "1. Ôn tập thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-d76fa71df681.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh bật-tắt đèn của cảm biến mắt"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-3eb49358f960.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh cài đặt tầm nhìn của mắt"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-b4b5e8e24cf7.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều chỉnh độ sáng của đèn"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-b520fb2ae5e9.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh khi mắt nhìn thấy vật thể"}, {"type": "text", "text": "Thẻ lệnh khi mắt nhìn thấy màu đỏ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-51b1917248bb.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh đo độ sáng của vật thể"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-69f43753f47a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh tương ứng, còn nếu điều kiện sai sẽ thực hiện câu lệnh tương ứng còn lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-324a1a26b9ef.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh lặp lại mãi mãi, lặp lại các câu lệnh bên trong từ lúc bắt đầu tới lúc dừng chương trình"}]}]]}, {"type": "text", "text": "2. Nhiệm vụ lập trình"}, {"type": "text", "text": "Nhiệm vụ 1: Lập trình cho đèn ở cảm biến mắt được bật khi điều kiện ánh sáng thấp và tắt khi đủ điều kiện ánh sáng"}, {"type": "image", "src": "/quiz/images/b87028842130-read-0c29e66a18d0.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/b87028842130-read-4b504933d79b.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 2: Lập trình khi mắt phát hiện vật thể thì bật đèn ở cảm biến để nhận biết rõ màu, LED Bumper sẽ hiển thị màu của vật thể (xanh hoặc đỏ)."}, {"type": "image", "src": "/quiz/images/b87028842130-read-6a2eb10c05a2.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Điền vào cột B công dụng của các thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cột A"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cột B"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-b47fa30e0038.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-72511b49673c.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-721ed55b4606.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/b87028842130-read-a92e9bf0ba66.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}]]}]}