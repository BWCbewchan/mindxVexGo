{"blocks": [{"type": "text", "text": "BÀI 1"}, {"type": "text", "text": "HỘI CHỢ VIỆC LÀM DÀNH CHO ROBOT"}, {"type": "text", "text": "1. Ý NGHĨA THẺ LỆNH"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-df610d1bfc42.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh giữ cho cánh tay kẹp chặt"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-6ebe9eff7720.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh rẽ trái-phải"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-4b42468ff193.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ … giây"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-c7d78c8acdb3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh vòng lặp, thực hiện lặp lại các thẻ lệnh bên trong… lần."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-78174f6eaaeb.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ cho đến khi cảm biến mắt thấy vật"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-fcebafc44675.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/7c9104a9a428-read-aea336e94c3e.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/7c9104a9a428-read-e2f05d20a73a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Hiển thị màu sắc trên Led Bumper Xanh lá/ Đỏ"}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "text", "text": "Nhiệm vụ 1: Lập trình xe di chuyển về phía trước trong 3 giây sau đó đi lùi 5 giây rồi dừng lại."}, {"type": "image", "src": "/quiz/images/7c9104a9a428-read-829540517f22.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/7c9104a9a428-read-fd54e742f095.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 2: Xe đi về phía trước\n-Nếu có vật cản màu đỏ thì xe rẽ trái"}, {"type": "text", "text": "-Nếu có vật cản màu xanh thì xe rẽ phải"}, {"type": "image", "src": "/quiz/images/7c9104a9a428-read-12468772f453.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 3: Xe di chuyển nếu vật được phát hiện là màu đỏ thì chuyển sang phải, còn nếu vật màu xanh thì chuyển sang trái"}, {"type": "image", "src": "/quiz/images/7c9104a9a428-read-c6a5c84c2762.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Điền vào cột B công dụng của các thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cột A"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cột B"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-7a1a6952f054.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-178ee2145a77.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read-85c4cbaf46c8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/7c9104a9a428-read