{"blocks": [{"type": "text", "text": "BÀI 2"}, {"type": "text", "text": "CẦN TRỤC THÔNG MINH"}, {"type": "text", "text": "1. Ý NGHĨA THẺ LỆNH"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/6cafb85fa961-read-1081e2fad2d6.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh di chuyển"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/6cafb85fa961-read-e98febab7fbb.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh quay motor nâng hàng"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/6cafb85fa961-read-36d6929f219e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh, nếu không thì không thực hiện gì cả"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/6cafb85fa961-read-69f43753f47a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh tương ứng, còn nếu điều kiện sai sẽ thực hiện câu lệnh tương ứng còn lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/6cafb85fa961-read-324a1a26b9ef.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh lặp lại mãi mãi, lặp lại các câu lệnh bên trong từ lúc bắt đầu tới lúc dừng chương trình"}]}]]}, {"type": "text", "text": "2. Nhiệm vụ lập trình"}, {"type": "text", "text": "Nhiệm vụ 1: Quay cần trục sang trái 100 độ. Sau đó hạ cần trục 3 giây"}, {"type": "text", "text": "Đợi 5 giây để nhân viên đặt hàng vào cần"}, {"type": "text", "text": "Nâng cần trục, di chuyển về vị trí ban đầu rồi xoay sang phải 60 độ và hạ hàng xuống."}, {"type": "image", "src": "/quiz/images/6cafb85fa961-read-49fa31a6dcf0.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/6cafb85fa961-read-23dba53f5325.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 2: Mô hình hoạt động liên tục"}, {"type": "text", "text": "Nếu cảm biến mắt nhìn thấy vật, hạ cần trục trong 5 giây, sau đó nâng cần trục trong 5 giây"}, {"type": "text", "text": "Nếu LED Bumper được nhấn, quay cần trục sang trái 150 độ"}, {"type": "image", "src": "/quiz/images/6cafb85fa961-read-7d1ba2ca9f7a.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Cho biết sự khác nhau về tác dụng giữa hai cặp lệnh này"}, {"type": "image", "src": "/quiz/images/6cafb85fa961-read-c03d18c9d57d.png", "text": "Hình gốc trong tài liệu"}]}