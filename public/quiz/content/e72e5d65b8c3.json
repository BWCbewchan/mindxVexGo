ff193.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ … giây"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/e72e5d65b8c3-read-c451a6ca2510.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Đợi đến khi, LED Bumper được ấn"}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "text", "text": "Lập trình di chuyển, và dừng khẩn cấp khi ấn vào LED Bumper"}, {"type": "image", "src": "/quiz/images/e72e5d65b8c3-read-207a042d47c6.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Đánh dấu ✔ vào ô em cho làm đúng nhất."}, {"type": "text", "text": "Chương trình nào dưới đây là chương trình đúng."}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/e72e5d65b8c3-read-7474ea28c2ff.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/e72e5d65b8c3-read-ebe91a50f669.png", "text": "Hình gốc trong tài liệu"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/e72e5d65b8c3-read-3f59439e11da.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/e72e5d65b8c3-read-bdcfc63846a4.png", "text": "Hình gốc trong tài liệu"}]}]]}]}