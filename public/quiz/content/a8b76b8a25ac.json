{"blocks": [{"type": "text", "text": "BUỔI 11"}, {"type": "text", "text": "ĐÈN TÍN HIỆU NGUY CẤP"}, {"type": "text", "text": "1. Ý NGHĨA THẺ LỆNH"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-330387c7189e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "LED Bumper còn dùng để hiển thị - phát màu là màu xanh lá và màu đỏ."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-7a1a6952f054.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-606b77397f22.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  quay không liên tục."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-15bc82ca037c.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-85c4cbaf46c8.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  quay liên tục"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-4353a80afa3a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thiết lập tốc độ của động cơ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-aa1a8337886e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Động cơ  dừng lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-4b42468ff193.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Chờ … giây"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-c451a6ca2510.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Đợi đến khi, LED Bumper được ấn"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-29e645c7d375.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-dc26c56e4f68.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh hút/nhả nam châm điện."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-ba36df6bbfbd.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-39f6e8d3acf6.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-178ee2145a77.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Đợi đến khi, Cảm biến mắt phát hiện màu Đỏ/Xanh lá/Xanh dương."}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-09bee258b9c4.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-eb995cbe7c0f.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-fc2da0ca23c3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Hiển thị màu sắc trên Led Bumper Xanh lá/ Đỏ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-c7d78c8acdb3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 2, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh vòng lặp, thực hiện lặp lại các thẻ lệnh bên trong… lần."}]}]]}, {"type": "text", "text": "2. NHIỆM VỤ BÀI HỌC"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Lập trình cho LED Bumper thay đổi màu sắc (từ Đỏ - Xanh - Tắt) theo thời gian (chờ 1 s) 10 lần."}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-5461451f52f3.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Lập trình cho LED Bumper hiển thị màu đỏ khi cảm biến mắt nhìn thấy vật và nhấn vào LED Bumper sẽ hiển thị lại màu xanh. Lặp lại với số lần nhất định"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-aab5d437e0ed.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-f7ad5ce3758a.png", "text": "Hình gốc trong tài liệu"}]}]]}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Đánh dấu ✔ vào ô em cho làm đúng nhất."}, {"type": "text", "text": "Thẻ lệnh nào dưới đây liên quan đến LED Bumper"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-49a0ab238d22.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-bd7c56a9743d.png", "text": "Hình gốc trong tài liệu"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-cb05ba3ff2ad.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "c"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/a8b76b8a25ac-read-725d301b9fe8.png", "text": "Hình gốc trong tài liệu"}]}]]}]}