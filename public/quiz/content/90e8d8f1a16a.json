{"blocks": [{"type": "text", "text": "BÀI 10"}, {"type": "text", "text": "TRUY TÌM BÁU VẬT"}, {"type": "text", "text": "1. Ôn tập thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-1081e2fad2d6.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh di chuyển bao gồm đi thẳng-đi lùi, rẽ trái-rẽ phải và câu lệnh điều chỉnh tốc độ"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-e98febab7fbb.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Nhóm câu lệnh quay motor nâng hàng"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-36d6929f219e.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh, nếu không thì không thực hiện gì cả"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-69f43753f47a.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh điều kiện, nếu điều kiện đúng sẽ thực hiện câu lệnh tương ứng, còn nếu điều kiện sai sẽ thực hiện câu lệnh tương ứng còn lại"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-324a1a26b9ef.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Thẻ lệnh lặp lại mãi mãi, lặp lại các câu lệnh bên trong từ lúc bắt đầu tới lúc dừng chương trình"}]}]]}, {"type": "text", "text": "2. Nhiệm vụ lập trình"}, {"type": "text", "text": "Nhiệm vụ 1: Lập trình xe di chuyển giao hàng đến nơi quy định"}, {"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-136f28e68a52.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-ae8be08aee0d.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-933e9cf758c7.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "Nhiệm vụ 2: Lập trình xe phát hiện kiện hàng và giao đến vị trí quy định trước."}, {"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-c504de3b3efb.png", "text": "Hình gốc trong tài liệu"}, {"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-8e886cdf1eb9.png", "text": "Hình gốc trong tài liệu"}, {"type": "text", "text": "3. BÀI TẬP"}, {"type": "text", "text": "Điền vào cột B công dụng của các thẻ lệnh đã học"}, {"type": "table", "text": "Bảng trong tài liệu gốc", "rows": [[{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cột A"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "text", "text": "Cột B"}]}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-95820eb424c5.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-e31315750890.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-28d41c1dbb83.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-273c29f8b2e4.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"type": "image", "src": "/quiz/images/90e8d8f1a16a-read-ca1caa57a6c6.png", "text": "Hình gốc trong tài liệu"}]}, {"colSpan": 1, "rowSpan": 1, "blocks": []}], [{"colSpan": 1, "rowSpan": 1, "blocks": [{"ty